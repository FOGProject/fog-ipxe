+/** X.509 certificate name constraints
+ *
+ * Held as raw cursors into the certificate's own DER, in the same way
+ * as the subjectAltName, so that no allocation or lifetime tracking is
+ * needed: the cursors are valid for exactly as long as the certificate.
+ */
+struct x509_name_constraints {
+	/** permittedSubtrees, if present */
+	struct asn1_cursor permitted;
+	/** excludedSubtrees, if present */
+	struct asn1_cursor excluded;
+	/** Constraints are present */
+	int present;
+};
