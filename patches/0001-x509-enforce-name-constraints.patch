 /** "id-ce-basicConstraints" object identifier */
 static uint8_t oid_ce_basic_constraints[] =
 	{ ASN1_OID_BASICCONSTRAINTS };
@@ -783,6 +914,10 @@ static uint8_t oid_pe_authority_info_access[] =
 static uint8_t oid_ce_subject_alt_name[] =
