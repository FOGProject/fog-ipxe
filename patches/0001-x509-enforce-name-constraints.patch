 					    root ) ) != 0 )
 			continue;
 
+		/* Remember where the validated path begins */
+		root_link = link;
+
 		/* Work back up to start of chain, performing pairwise
 		 * validation.
 		 */
@@ -1940,6 +2389,11 @@ int x509_validate_chain ( struct x509_chain *chain, time_t time,
 			issuer = link->cert;
 		}
 
+		/* Enforce name constraints across the validated path */
+		if ( ( rc = x509_check_path_name_constraints
+		       ( chain, root_link ) ) != 0 )
+			return rc;
+
 		return 0;
 	}
 
