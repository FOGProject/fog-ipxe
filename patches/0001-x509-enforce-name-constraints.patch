+/**
+ * Check that a list of general subtrees can be enforced
+ *
+ * @v cert		X.509 certificate
+ * @v subtrees		General subtrees
+ * @ret rc		Return status code
+ *
+ * A name constraint that we cannot evaluate must cause the certificate
+ * to be rejected rather than ignored: the extension is marked critical
+ * precisely so that a verifier unable to enforce it refuses to proceed.
+ *
+ * This is checked once, when the extension is parsed, rather than when
+ * names are compared.  A constraint on a name type that no certificate
+ * in the chain happens to use would otherwise never be examined, and
+ * the chain would be accepted without the constraint having been
+ * enforced.
+ */
+static int x509_check_subtrees_supported ( struct x509_certificate *cert,
+					   const struct asn1_cursor *subtrees ){
+	struct asn1_cursor list;
+	struct asn1_cursor subtree;
+	unsigned int type;
+	int rc;
+
+	memcpy ( &list, subtrees, sizeof ( list ) );
+	for ( ; list.len ; asn1_skip_any ( &list ) ) {
+
+		/* Enter GeneralSubtree */
+		memcpy ( &subtree, &list, sizeof ( subtree ) );
+		if ( ( rc = asn1_enter ( &subtree, ASN1_SEQUENCE ) ) != 0 ) {
+			DBGC ( cert, "X509 %p invalid GeneralSubtree: %s\n",
+			       cert, strerror ( rc ) );
+			return rc;
+		}
+
+		/* Check the base name type */
+		type = asn1_type ( &subtree );
+		switch ( type ) {
+		case X509_GENERAL_NAME_DNS :
+		case X509_GENERAL_NAME_IP :
+			break;
+		default:
+			DBGC ( cert, "X509 %p has name constraint of "
+			       "unsupported type %#02x\n", cert, type );
+			return -ENOTSUP_CONSTRAINT;
+		}
+		asn1_skip_any ( &subtree );
+
+		/* Reject minimum and maximum.  RFC 5280 section 4.2.1.10
+		 * requires minimum to be absent (it defaults to zero) and
+		 * maximum to be absent; neither is implemented here, so
+		 * anything remaining cannot be enforced.
+		 */
+		if ( subtree.len != 0 ) {
+			DBGC ( cert, "X509 %p has name constraint with "
+			       "minimum and/or maximum\n", cert );
+			return -ENOTSUP_CONSTRAINT;
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * Parse X.509 certificate name constraints
+ *
+ * @v cert		X.509 certificate
+ * @v raw		ASN.1 cursor
+ * @ret rc		Return status code
+ */
+static int x509_parse_name_constraints ( struct x509_certificate *cert,
+					 const struct asn1_cursor *raw ) {
+	struct x509_name_constraints *constraints =
+		&cert->extensions.name_constraints;
+	struct asn1_cursor cursor;
+	int rc;
+
+	/* Enter nameConstraints */
+	memcpy ( &cursor, raw, sizeof ( cursor ) );
+	if ( ( rc = asn1_enter ( &cursor, ASN1_SEQUENCE ) ) != 0 ) {
+		DBGC ( cert, "X509 %p invalid nameConstraints: %s\n",
+		       cert, strerror ( rc ) );
+		DBGC_HDA ( cert, 0, raw->data, raw->len );
+		return rc;
+	}
+
+	/* Record permittedSubtrees, if present */
+	if ( asn1_type ( &cursor ) == ASN1_EXPLICIT_TAG ( 0 ) ) {
+		memcpy ( &constraints->permitted, &cursor,
+			 sizeof ( constraints->permitted ) );
+		if ( ( rc = asn1_enter ( &constraints->permitted,
+					 ASN1_EXPLICIT_TAG ( 0 ) ) ) != 0 ) {
+			DBGC ( cert, "X509 %p invalid permittedSubtrees: %s\n",
+			       cert, strerror ( rc ) );
+			return rc;
+		}
+		if ( ( rc = x509_check_subtrees_supported
+		       ( cert, &constraints->permitted ) ) != 0 )
+			return rc;
+		asn1_skip_any ( &cursor );
+	}
+
+	/* Record excludedSubtrees, if present */
+	if ( asn1_type ( &cursor ) == ASN1_EXPLICIT_TAG ( 1 ) ) {
+		memcpy ( &constraints->excluded, &cursor,
+			 sizeof ( constraints->excluded ) );
+		if ( ( rc = asn1_enter ( &constraints->excluded,
+					 ASN1_EXPLICIT_TAG ( 1 ) ) ) != 0 ) {
+			DBGC ( cert, "X509 %p invalid excludedSubtrees: %s\n",
+			       cert, strerror ( rc ) );
+			return rc;
+		}
+		if ( ( rc = x509_check_subtrees_supported
+		       ( cert, &constraints->excluded ) ) != 0 )
+			return rc;
+	}
+
+	constraints->present = 1;
+	DBGC2 ( cert, "X509 %p has nameConstraints\n", cert );
+
+	return 0;
+}
