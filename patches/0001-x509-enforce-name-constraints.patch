 };
 
 /**
@@ -1590,6 +1730,311 @@ int x509_check_name ( struct x509_certificate *cert, const char *name ) {
 	return -EACCES_WRONG_NAME;
 }
 
+/** Result of matching one name against one list of general subtrees */
+enum x509_name_constraint_result {
+	/** No subtree constrains this name's type */
+	X509_NC_UNCONSTRAINED = 0,
+	/** The name matches at least one subtree */
+	X509_NC_MATCH,
+	/** Subtrees of this name's type exist, but none match */
+	X509_NC_MISMATCH,
+};
+
+/**
+ * Check X.509 DNS name against a name constraint
+ *
+ * @v cert		X.509 certificate
+ * @v name		dNSName from the certificate
+ * @v base		dNSName from the constraint
+ * @ret rc		Return status code
+ *
+ * Per RFC 5280 section 4.2.1.10 a dNSName constraint matches a name
+ * that is equal to it, or that extends it to the left on a label
+ * boundary: "example.com" is satisfied by "host.example.com" but not
+ * by "notexample.com".
+ */
+static int x509_check_dnsname_constraint ( struct x509_certificate *cert,
+					   const struct asn1_cursor *name,
+					   const struct asn1_cursor *base ) {
+	const char *dnsname = name->data;
+	const char *constraint = base->data;
+	size_t namelen = name->len;
+	size_t baselen = base->len;
+
+	/* An empty constraint matches every name of this type */
+	if ( baselen == 0 )
+		return 0;
+
+	/* A name shorter than the constraint can never match */
+	if ( namelen < baselen )
+		return -ENOENT;
+
+	/* A longer name must extend the constraint at a label boundary.
+	 * A constraint that already begins with a separator supplies its
+	 * own boundary, and must not also match the bare domain.
+	 */
+	if ( namelen > baselen ) {
+		if ( ( constraint[0] != '.' ) &&
+		     ( dnsname[ namelen - baselen - 1 ] != '.' ) )
+			return -ENOENT;
+	}
+
+	/* Compare the tail */
+	if ( strncasecmp ( ( dnsname + namelen - baselen ), constraint,
+			   baselen ) != 0 )
+		return -ENOENT;
+
+	DBGC2 ( cert, "X509 %p \"%s\" dNSName matches constraint\n",
+		cert, x509_name ( cert ) );
+	return 0;
+}
+
+/**
+ * Check X.509 IP address against a name constraint
+ *
+ * @v cert		X.509 certificate
+ * @v name		iPAddress from the certificate
+ * @v base		iPAddress from the constraint
+ * @ret rc		Return status code
+ *
+ * A constraint holds an address followed by a mask of the same length,
+ * so an IPv4 constraint is eight bytes and an IPv6 constraint is
+ * thirty-two.  An address of a different length belongs to a different
+ * family and can never match, which is what keeps IPv4 and IPv6
+ * subtrees from matching each other.
+ */
+static int x509_check_ipaddress_constraint ( struct x509_certificate *cert,
+					     const struct asn1_cursor *name,
+					     const struct asn1_cursor *base ) {
+	const uint8_t *address = name->data;
+	const uint8_t *network = base->data;
+	const uint8_t *netmask;
+	size_t len = name->len;
+	unsigned int i;
+
+	/* Reject anything that is not an address plus a mask */
+	if ( base->len != ( 2 * len ) )
+		return -ENOENT;
+	netmask = ( network + len );
+
+	/* Compare the masked address */
+	for ( i = 0 ; i < len ; i++ ) {
+		if ( ( ( address[i] ^ network[i] ) & netmask[i] ) != 0 )
+			return -ENOENT;
+	}
+
+	DBGC2 ( cert, "X509 %p \"%s\" iPAddress matches constraint\n",
+		cert, x509_name ( cert ) );
+	return 0;
+}
+
+/**
+ * Check X.509 general name against a list of general subtrees
+ *
+ * @v cert		X.509 certificate
+ * @v name		General name contents
+ * @v type		General name type
+ * @v subtrees		General subtrees
+ * @ret rc		Match result, or negative status code
+ *
+ * Only subtrees of the same name type participate: RFC 5280 constrains
+ * a name only if the constraint set names its type, so a name of a type
+ * that no subtree mentions is unconstrained.  Subtree types that cannot
+ * be enforced have already been refused when the extension was parsed.
+ */
+static int x509_check_subtrees ( struct x509_certificate *cert,
+				 const struct asn1_cursor *name,
+				 unsigned int type,
+				 const struct asn1_cursor *subtrees ) {
+	struct asn1_cursor list;
+	struct asn1_cursor subtree;
+	struct asn1_cursor base;
+	int result = X509_NC_UNCONSTRAINED;
+	int rc;
+
+	memcpy ( &list, subtrees, sizeof ( list ) );
+	for ( ; list.len ; asn1_skip_any ( &list ) ) {
+
+		/* Enter GeneralSubtree and extract the base name */
+		memcpy ( &subtree, &list, sizeof ( subtree ) );
+		if ( ( rc = asn1_enter ( &subtree, ASN1_SEQUENCE ) ) != 0 )
+			return rc;
+		memcpy ( &base, &subtree, sizeof ( base ) );
+		if ( asn1_type ( &base ) != type )
+			continue;
+		if ( ( rc = asn1_enter_any ( &base ) ) != 0 )
+			return rc;
+
+		/* This name's type is constrained, whether or not it matches */
+		if ( result == X509_NC_UNCONSTRAINED )
+			result = X509_NC_MISMATCH;
+
+		switch ( type ) {
+		case X509_GENERAL_NAME_DNS :
+			rc = x509_check_dnsname_constraint ( cert, name,
+							     &base );
+			break;
+		case X509_GENERAL_NAME_IP :
+			rc = x509_check_ipaddress_constraint ( cert, name,
+							       &base );
+			break;
+		default:
+			/* Refused at parse time; unreachable here */
+			return -ENOTSUP_CONSTRAINT;
+		}
+		if ( rc == 0 )
+			result = X509_NC_MATCH;
+	}
+
+	return result;
+}
+
+/**
+ * Check X.509 certificate names against an issuing CA's name constraints
+ *
+ * @v cert		X.509 certificate
+ * @v ca		Constraining CA certificate
+ * @ret rc		Return status code
+ */
+static int x509_check_name_constraints ( struct x509_certificate *cert,
+					 struct x509_certificate *ca ) {
+	struct x509_name_constraints *constraints =
+		&ca->extensions.name_constraints;
+	struct asn1_cursor alt_name;
+	struct asn1_cursor name;
+	unsigned int type;
+	int rc;
+
+	/* Nothing to do unless this CA constrains its subordinates */
+	if ( ! constraints->present )
+		return 0;
+
+	/* Check each subjectAltName.  The subject distinguished name is
+	 * constrained by directoryName subtrees, which are refused at
+	 * parse time, so a constraint set that reaches here concerns
+	 * subject alternative names only.
+	 */
+	memcpy ( &alt_name, &cert->extensions.alt_name.names,
+		 sizeof ( alt_name ) );
+	for ( ; alt_name.len ; asn1_skip_any ( &alt_name ) ) {
+
+		memcpy ( &name, &alt_name, sizeof ( name ) );
+		type = asn1_type ( &name );
+		if ( ( rc = asn1_enter_any ( &name ) ) != 0 )
+			return rc;
+
+		/* Any match against an excluded subtree is fatal */
+		if ( constraints->excluded.len ) {
+			rc = x509_check_subtrees ( cert, &name, type,
+						   &constraints->excluded );
+			if ( rc < 0 )
+				return rc;
+			if ( rc == X509_NC_MATCH ) {
+				DBGC ( cert, "X509 %p \"%s\" ",
+				       cert, x509_name ( cert ) );
+				DBGC ( cert, "matches excluded subtree of "
+				       "%p \"%s\"\n", ca, x509_name ( ca ) );
+				return -EACCES_NAME_CONSTRAINT;
+			}
+		}
+
+		/* A constrained name type must match a permitted subtree */
+		if ( constraints->permitted.len ) {
+			rc = x509_check_subtrees ( cert, &name, type,
+						   &constraints->permitted );
+			if ( rc < 0 )
+				return rc;
+			if ( rc == X509_NC_MISMATCH ) {
+				DBGC ( cert, "X509 %p \"%s\" ",
+				       cert, x509_name ( cert ) );
+				DBGC ( cert, "matches no permitted subtree of "
+				       "%p \"%s\"\n", ca, x509_name ( ca ) );
+				return -EACCES_NAME_CONSTRAINT;
+			}
+		}
+	}
+
+	/* Constrain the commonName of an end entity that has no
+	 * subjectAltName.
+	 *
+	 * RFC 5280 constrains the subject distinguished name through
+	 * directoryName subtrees, which are refused at parse time, so on a
+	 * strict reading nothing here would examine the commonName at all.
+	 * That would leave a way around the constraint: x509_check_name()
+	 * accepts a commonName as a host name, so a compromised
+	 * constrained CA could issue a certificate bearing only
+	 * "CN=somewhere.else" and it would be trusted for that name.
+	 *
+	 * The check is deliberately narrow.  It applies only when the
+	 * certificate carries no subjectAltName at all -- if it has one,
+	 * the subjectAltName is authoritative and has already been checked
+	 * above -- and only to end entities, since a CA's commonName is a
+	 * label rather than a host name and constraining it would break
+	 * every chain.  OpenSSL applies a broader version of the same
+	 * check; this is the subset that cannot reject a certificate whose
+	 * commonName was never going to be used as a name.
+	 */
+	if ( constraints->permitted.len &&
+	     ( cert->extensions.alt_name.names.len == 0 ) &&
+	     ( ! cert->extensions.basic.ca ) ) {
+
+		rc = x509_check_subtrees ( cert, &cert->subject.common_name,
+					   X509_GENERAL_NAME_DNS,
+					   &constraints->permitted );
+		if ( rc < 0 )
+			return rc;
+		if ( rc == X509_NC_MISMATCH ) {
+			DBGC ( cert, "X509 %p \"%s\" ",
+			       cert, x509_name ( cert ) );
+			DBGC ( cert, "commonName matches no permitted subtree "
+			       "of %p \"%s\"\n", ca, x509_name ( ca ) );
+			return -EACCES_NAME_CONSTRAINT;
+		}
+	}
+
+	return 0;
+}
+
+/**
+ * Enforce name constraints across a validated certificate path
+ *
+ * @v chain		X.509 certificate chain
+ * @v root_link		Link at which validation began
+ * @ret rc		Return status code
+ *
+ * A constraining CA binds every certificate below it in the path, not
+ * merely the one it issued, so this cannot be folded into
+ * x509_validate() the way the path length constraint is: there is no
+ * single inherited value to carry down.  Paths are short enough that
+ * checking each certificate against every ancestor costs nothing.
+ */
+static int x509_check_path_name_constraints ( struct x509_chain *chain,
+					      struct x509_link *root_link ) {
+	struct x509_link *link;
+	struct x509_link *ancestor;
+	int rc;
+
+	/* The chain is ordered leaf first, so a certificate's issuers are
+	 * the entries that follow it, up to and including the trusted
+	 * certificate at which validation began.  Anything beyond that
+	 * point was never validated and must not constrain anything.
+	 */
+	list_for_each_entry ( link, &chain->links, list ) {
+		ancestor = link;
+		list_for_each_entry_continue ( ancestor, &chain->links, list ) {
+			if ( ( rc = x509_check_name_constraints
+			       ( link->cert, ancestor->cert ) ) != 0 )
+				return rc;
+			if ( ancestor == root_link )
+				break;
+		}
+		if ( link == root_link )
+			break;
+	}
+
+	return 0;
+}
