+	X509_GENERAL_NAME_RFC822 = ASN1_IMPLICIT_TAG ( 1 ),
 	X509_GENERAL_NAME_DNS = ASN1_IMPLICIT_TAG ( 2 ),
+	X509_GENERAL_NAME_DIRECTORY = ASN1_EXPLICIT_TAG ( 4 ),
